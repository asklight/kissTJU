{
  "name": "kiss_TJU",
  "version": "1.5.10",
  "manifest_version": 3,
  "description": "A collection of tools to improve TJUer's life experience",
  "icons": {
    "16": "icons/chuxuan16x16.png",
    "32": "icons/chuxuan32x32.png",
    "48": "icons/chuxuan48x48.png",
    "128": "icons/chuxuan128x128.png"
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://classes.tju.edu.cn/*",
        "*://saa.tju.edu.cn/*",
        "*://seatw.lib.tju.edu.cn/*",
        "*://www.lib.tju.edu.cn/*",
        "*://map.tju.edu.cn/*",
        "*://serv.tju.edu.cn/*",
        "*://ee.tju.edu.cn/*",
        "*://theory.twt.edu.cn/*",
        "*://cet.neea.edu.cn/*",
        "*://tyapp.chingo.cn/cgapp/*",
        "*://www.icourse163.org/*",
        "*://icourse163.org/*",
        "*://sso.tju.edu.cn/*",
        "*://www.pigai.org/*",
        "*://pigai.org/*",
        "*://121.193.132.43/*"
      ],
      "js": [
        "robotLib.js",
        "genshinBG.js",
        "tesseract.js",
        "chuxuan.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "tabs",
    "storage"
  ]
}
